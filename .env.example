# Copie para .env.local e preencha. O .env.local é ignorado pelo git.
#
# Setup único, todo gratuito (nenhum passo abaixo exige cartão de crédito):
#
#   1. console.cloud.google.com → criar projeto → APIs & Services → habilitar "Google Sheets API"
#   2. IAM & Admin → Service Accounts → criar → Keys → Add key → JSON → baixar
#   3. mover o JSON para ./secrets/service-account.json (a pasta é git-ignored)
#   4. criar uma planilha VAZIA no seu Google Drive
#   5. compartilhar a planilha com o e-mail da service account (client_email do JSON),
#      com permissão de Editor
#   6. copiar o ID da planilha da URL e colar abaixo:
#      docs.google.com/spreadsheets/d/<ESTE-PEDACO-AQUI>/edit

# ID da planilha (obrigatório)
CARTEIRA_SPREADSHEET_ID=

# Caminho para a chave JSON da service account (obrigatório)
CARTEIRA_SERVICE_ACCOUNT_PATH=./secrets/service-account.json
